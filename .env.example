# ===== 通用 LLM 配置 =====
# 复制为 .env 后填值：cp .env.example .env
# 脚本会自动加载项目根 .env（通过 scripts/lib/env.js 的 loadDotenvInto）

# 必填：LLM API Key（Anthropic 和 MiniMax 共用此变量名）
# Anthropic 获取地址：https://console.anthropic.com/settings/keys
# MiniMax 获取地址：https://platform.minimaxi.com
LLM_API_KEY=sk-ant-...

# ===== Anthropic / LLM 配置 =====
# 可选：自定义 base URL（兼容自定义网关 / 代理）
# 默认：https://api.anthropic.com
# LLM_BASE_URL=https://your-gateway.example.com

# 可选：模型 ID
# 默认：claude-opus-4-8
# LLM_MODEL=claude-opus-4-8

# 可选：并发数（generate-interpretations 使用）
# 默认：4
# INTERPRETATION_CONCURRENCY=4

# ===== MiniMax T2I 配置 =====
# API 基础地址
# 默认：https://api.minimaxi.com/v1
# API_URL=https://api.minimaxi.com/v1

# 默认生成参数
# T2I_DEFAULT_MODEL=image-01
# T2I_DEFAULT_ASPECT_RATIO=1:1
# T2I_DEFAULT_N=1
# T2I_DEFAULT_STYLE_WEIGHT=0.8
# T2I_DEFAULT_RESPONSE_FORMAT=url
# T2I_DEFAULT_OUTPUT_DIR=./public/images

# 请求控制
# T2I_TIMEOUT_MS=30000
# T2I_RETRY_MAX=3
# T2I_RETRY_BASE_DELAY_MS=1000

# 预设文件路径
# T2I_PRESETS_FILE=scripts/lib/t2i/presets.json
